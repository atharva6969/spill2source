# ---- Oil Spill Detection & Vessel Attribution - configuration ----

# Copernicus Data Space Ecosystem (free account: https://dataspace.copernicus.eu)
# Enables download of Sentinel-1 GRD scenes so the SAR detector runs end-to-end.
CDSE_USER=
CDSE_PASS=

# Sentinel Hub Process API (same CDSE account) - fetches ONLY the AOI window
# (a few MB) instead of the ~650 MB single-band product. Strongly recommended.
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
# (User settings -> OAuth clients -> "Create new"), then paste id + secret here.
# When both are set, scene scans use Sentinel Hub; otherwise they fall back to
# the partial single-band download.
SH_CLIENT_ID=
SH_CLIENT_SECRET=
# Ground resolution (metres/pixel) requested from Sentinel Hub. ~40 m matches
# the effective resolution of the download path; lower = sharper but more tiles.
SH_RESOLUTION_M=40

# Area of interest: Gulf of Finland / Baltic approach (lon_min, lat_min, lon_max, lat_max)
AOI_BBOX=21.8,58.9,30.6,60.7

# Poll intervals (seconds)
AIS_POLL_SECONDS=30
MET_REFRESH_SECONDS=3600
SAT_POLL_SECONDS=600

# Drift model
DRIFT_HOURS_BACK=18
DRIFT_HOURS_FWD=24
PARTICLES=600

# Storage
DATA_DIR=data
DB_PATH=data/app.db

# API authentication (empty = no auth; set a key to protect endpoints)
API_KEY=

# Scene cache management (limits disk usage from downloaded Sentinel-1 scenes)
# Extracted SAFE dirs are auto-deleted after processing; zips pruned when cache exceeds this.
SCENE_CACHE_MAX_GB=10
# Scenes older than this are deleted entirely (days).
SCENE_TTL_DAYS=7
